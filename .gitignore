.DS_Store
.idea
*.log
tmp/

# Claude Code session state, and the throwaway git worktrees it creates
# under .claude/worktrees/ -- those are checkouts of this same repo, so
# leaving them untracked keeps greps, reviews, and `doom sync` from
# picking up a second, stale copy of every module.
.claude/

*~

/private

*.elc

# Emacs-generated machine state (fonts, package selections, etc. written by
# `customize'), specific to this install and not meant to be checked in --
# left untracked deliberately, so this stops it showing as noise in every
# `git status'.
/custom.el
